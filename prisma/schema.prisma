// Zestora Production-Grade Database Schema
// Modeled strictly in accordance with Master Project Prompt — ZESTORA

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  RESTAURANT_OWNER
  RESTAURANT_MANAGER
  DELIVERY_PARTNER
  GROCERY_MANAGER
  ADMIN
  SUPER_ADMIN
  SUPPORT_AGENT
}

enum OrderStatus {
  PLACED
  PAYMENT_PENDING
  CONFIRMED
  RESTAURANT_ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  DELIVERY_ASSIGNED
  PICKED_UP
  ON_THE_WAY
  ARRIVING
  DELIVERED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  CASH_ON_DELIVERY
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  ORDER_ISSUE
  PAYMENT_ISSUE
  MISSING_ITEM
  WRONG_ITEM
  LATE_DELIVERY
  REFUND_ISSUE
  RESTAURANT_ISSUE
  ACCOUNT_ISSUE
  OTHER
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

enum PartnerOnlineStatus {
  ONLINE
  OFFLINE
  BUSY
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  phone           String?          @unique
  passwordHash    String?
  avatar          String?
  role            Role             @default(CUSTOMER)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  favoriteRestaurants FavoriteRestaurant[]
  favoriteItems   FavoriteItem[]
  supportTickets  SupportTicket[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  ownedRestaurants Restaurant[]    @relation("RestaurantOwner")
  deliveryProfile DeliveryPartner?
  cart            Cart?
}

model Address {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String    // e.g. "Home", "Work", "Other"
  fullName            String
  phone               String
  addressLine1        String
  addressLine2        String?
  area                String
  city                String    @default("Bhatkal")
  state               String    @default("Karnataka")
  postalCode          String
  country             String    @default("India")
  latitude            Float?
  longitude           Float?
  deliveryInstructions String?
  isDefault           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders              Order[]
}

model Restaurant {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  ownerId         String
  owner           User                 @relation("RestaurantOwner", fields: [ownerId], references: [id])
  description     String?
  cuisine         String               // e.g. "Indian, Mughlai, Chinese"
  logo            String?
  coverImage      String?
  rating          Float                @default(4.5)
  ratingCount     Int                  @default(0)
  deliveryTimeMin Int                  @default(25)
  deliveryTimeMax Int                  @default(35)
  deliveryFee     Float                @default(30.0)
  minimumOrder    Float                @default(150.0)
  commissionRate  Float                @default(0.20) // 20% commission
  isOpen          Boolean              @default(true)
  isVerified      Boolean              @default(true)
  addressLine     String
  area            String
  city            String               @default("Bhatkal")
  latitude        Float?
  longitude       Float?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  branches        RestaurantBranch[]
  documents       RestaurantDocument[]
  categories      RestaurantCategory[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  orders          Order[]
  reviews         Review[]
  offers          Offer[]
  settlements     Settlement[]
  favorites       FavoriteRestaurant[]
}

model RestaurantBranch {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchName   String
  address      String
  phone        String
  latitude     Float
  longitude    Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model RestaurantDocument {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  documentType String     // FSSAI, GST, PAN, Business License
  documentUrl  String
  isVerified   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model RestaurantCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime   @default(now())
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String     // e.g. "Starters", "Main Course", "Biryani"
  sortOrder    Int        @default(0)
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model MenuItem {
  id              String         @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId      String
  category        MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Float
  image           String?
  isVeg           Boolean        @default(true)
  isAvailable     Boolean        @default(true)
  preparationTime Int            @default(15) // minutes
  spiceLevel      String?        // Mild, Medium, Spicy
  rating          Float          @default(4.5)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  variants        MenuVariant[]
  addons          MenuAddon[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  favorites       FavoriteItem[]
}

model MenuVariant {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String   // "Small", "Medium", "Large", "Half", "Full"
  price      Float
  createdAt  DateTime @default(now())
}

model MenuAddon {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String   // "Extra Cheese", "Olives", "Extra Gravy"
  price      Float
  createdAt  DateTime @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id             String    @id @default(cuid())
  cartId         String
  cart           Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id])
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id])
  quantity       Int       @default(1)
  variantName    String?
  variantPrice   Float?
  selectedAddons Json?     // [{ name: string, price: number }]
  instructions   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Order {
  id                 String               @id @default(cuid())
  orderNumber        String               @unique // e.g. ZES-20260921-10482
  customerId         String
  customer           User                 @relation(fields: [customerId], references: [id])
  restaurantId       String?
  restaurant         Restaurant?          @relation(fields: [restaurantId], references: [id])
  groceryStoreId     String?
  groceryStore       GroceryStore?        @relation(fields: [groceryStoreId], references: [id])
  addressId          String
  address            Address              @relation(fields: [addressId], references: [id])
  status             OrderStatus          @default(PLACED)
  subtotal           Float
  packagingFee       Float                @default(15.0)
  deliveryFee        Float                @default(30.0)
  platformFee        Float                @default(5.0)
  taxes              Float                @default(0.0)
  tip                Float                @default(0.0)
  discount           Float                @default(0.0)
  totalAmount        Float
  deliveryType       String               @default("STANDARD") // STANDARD or SCHEDULED
  scheduledTime      DateTime?
  rejectionReason    String?
  estimatedDelivery  DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payment            Payment?
  deliveryAssignment DeliveryAssignment?
  review             Review?
  couponUsages       CouponUsage[]
}

model OrderItem {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   String?
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id])
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id])
  name         String
  unitPrice    Float
  quantity     Int
  totalPrice   Float
  variantName  String?
  addons       Json?
  instructions String?
  createdAt    DateTime  @default(now())
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  timestamp DateTime    @default(now())
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Float
  currency       String        @default("INR")
  transactionRef String?
  gateway        String        @default("MOCK") // MOCK or RAZORPAY
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  refund         Refund?
}

model Refund {
  id          String       @id @default(cuid())
  paymentId   String       @unique
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Float
  reason      String
  status      RefundStatus @default(REQUESTED)
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Coupon {
  id             String        @id @default(cuid())
  code           String        @unique
  type           CouponType    @default(PERCENTAGE)
  discountValue  Float         // e.g. 50 (for 50%) or 100 (for ₹100 off)
  minimumOrder   Float         @default(199.0)
  maxDiscount    Float?        // e.g. 100
  usageLimit     Int           @default(1000)
  usedCount      Int           @default(0)
  perUserLimit   Int           @default(1)
  isActive       Boolean       @default(true)
  startDate      DateTime      @default(now())
  endDate        DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  usages         CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  userId    String
  discount  Float
  createdAt DateTime @default(now())
}

model Offer {
  id           String      @id @default(cuid())
  title        String
  description  String
  discountText String      // e.g. "FLAT 20% OFF", "BUY 1 GET 1"
  bannerImage  String?
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
}

model FavoriteRestaurant {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
}

model FavoriteItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, menuItemId])
}

model Review {
  id               String       @id @default(cuid())
  orderId          String       @unique
  order            Order        @relation(fields: [orderId], references: [id])
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  restaurantId     String
  restaurant       Restaurant   @relation(fields: [restaurantId], references: [id])
  foodRating       Int          // 1 - 5
  packagingRating  Int          @default(5)
  deliveryRating   Int          @default(5)
  comment          String?
  isVerifiedOrder  Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  reply            ReviewReply?
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  replyText String
  createdAt DateTime @default(now())
}

model DeliveryPartner {
  id            String              @id @default(cuid())
  userId        String              @unique
  user          User                @relation(fields: [userId], references: [id])
  vehicleNumber String
  vehicleType   String              // Bike, Scooter, Cycle
  licenseNumber String?
  isVerified    Boolean             @default(true)
  onlineStatus  PartnerOnlineStatus @default(ONLINE)
  rating        Float               @default(4.8)
  totalTrips    Int                 @default(0)
  walletBalance Float               @default(0.0)
  currentLat    Float?
  currentLng    Float?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  assignments   DeliveryAssignment[]
}

model DeliveryAssignment {
  id           String          @id @default(cuid())
  orderId      String          @unique
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId    String
  partner      DeliveryPartner @relation(fields: [partnerId], references: [id])
  assignedAt   DateTime        @default(now())
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  baseFee      Float           @default(30.0)
  distanceFee  Float           @default(20.0)
  peakBonus    Float           @default(10.0)
  tip          Float           @default(0.0)
  totalEarning Float           @default(60.0)
  status       String          @default("ASSIGNED") // ASSIGNED, ACCEPTED, PICKED_UP, DELIVERED
}

model GroceryStore {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  address     String
  city        String            @default("Bhatkal")
  rating      Float             @default(4.7)
  deliveryEta String            @default("10-20 min")
  isOpen      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  categories  ProductCategory[]
  products    Product[]
  orders      Order[]
}

model ProductCategory {
  id        String       @id @default(cuid())
  storeId   String
  store     GroceryStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String       // Dairy & Eggs, Snacks, Vegetables, Fruits, Personal Care
  icon      String?
  createdAt DateTime     @default(now())

  products  Product[]
}

model Product {
  id          String          @id @default(cuid())
  storeId     String
  store       GroceryStore    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  brand       String?
  description String?
  image       String?
  mrp         Float
  price       Float
  unit        String          // "1 L", "500 g", "1 pack"
  stock       Int             @default(50)
  reserved    Int             @default(0)
  sku         String          @unique
  barcode     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model ServiceArea {
  id           String   @id @default(cuid())
  city         String   @default("Bhatkal")
  zoneName     String   // e.g. "Bhatkal Central", "Sonar Keri", "Nawayath Colony"
  postalCode   String
  radiusKm     Float    @default(8.0)
  baseDelivery Float    @default(30.0)
  minOrder     Float    @default(100.0)
  surgeFee     Float    @default(0.0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Settlement {
  id                 String     @id @default(cuid())
  restaurantId       String
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id])
  grossSales         Float
  commissionRate     Float      @default(0.20)
  platformCommission Float
  payoutAmount       Float
  periodStart        DateTime
  periodEnd          DateTime
  status             String     @default("PENDING") // PENDING, PAID
  createdAt          DateTime   @default(now())
}

model SupportTicket {
  id        String                @id @default(cuid())
  ticketId  String                @unique // TKT-89213
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  orderId   String?
  category  SupportTicketCategory @default(ORDER_ISSUE)
  subject   String
  priority  String                @default("NORMAL")
  status    SupportTicketStatus   @default(OPEN)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  messages  SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String        // "USER" or "SUPPORT_AGENT"
  message   String
  createdAt DateTime      @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // e.g. "UPDATE_COMMISSION", "APPROVE_RESTAURANT"
  entity    String   // e.g. "Restaurant", "Coupon", "Order"
  entityId  String
  oldValue  String?
  newValue  String?
  ipAddress String?
  createdAt DateTime @default(now())
}
