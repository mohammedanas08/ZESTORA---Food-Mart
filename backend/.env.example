# Copy to backend/.env (ignored by git) and fill in. Never commit real values.
# Used by: docker compose (database container), `mvn spring-boot:run` (dev profile), and as a checklist for production env vars.

# ── Database ─────────────────────────────────────────────────────────────
# Local Docker database (docker-compose.yml). For a hosted PostgreSQL, set all three to that database's values.
DATABASE_URL=jdbc:postgresql://localhost:5433/zestora
DATABASE_USERNAME=zestora
DATABASE_PASSWORD=change-me

# ── Auth ─────────────────────────────────────────────────────────────────
# Signs login tokens. At least 32 random characters. Generate:  openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# ── Demo data (dev profile only) ─────────────────────────────────────────
# Password shared by every seeded demo account (customer, admin, rider, restaurant owners). At least 8 characters.
DEMO_PASSWORD=change-me-demo

# ── Web ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# ── Payments (Razorpay): leave empty in dev to use the built-in payment simulator ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Image uploads (Cloudinary): leave empty until you set up an account ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
