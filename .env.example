# Zestora Environment Configuration
# Copy this file to .env.local and fill in your values

# ============================================================
# DATABASE (PostgreSQL + Prisma)
# ============================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/zestora_db?schema=public"

# ============================================================
# SESSION (HMAC signing key for the login cookie) - REQUIRED in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Set to false to disable the demo /api/payments/simulate endpoint (always disabled in production)
ALLOW_PAYMENT_SIMULATION="true"

# ============================================================
# AUTHENTICATION (NextAuth.js - optional future integration)
# ============================================================
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# PAYMENT GATEWAY (Razorpay - optional, Mock is default in demo)
# ============================================================
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# ============================================================
# CLOUD STORAGE (for restaurant logos, cover images)
# ============================================================
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ============================================================
# MAPS & GEOLOCATION (for live GPS tracking - optional)
# ============================================================
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# ============================================================
# NOTIFICATIONS (Firebase - optional)
# ============================================================
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# ============================================================
# APPLICATION SETTINGS
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Zestora"
NEXT_PUBLIC_APP_CITY="Bhatkal"
NEXT_PUBLIC_PLATFORM_COMMISSION_RATE=0.20
NODE_ENV="development"
